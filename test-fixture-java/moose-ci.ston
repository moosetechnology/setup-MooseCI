MooseCIConfig {
	#projectLanguage : #java,
	#metrics : [
		#packages,
		#classes
	],
	#rules : [
		#too_many_parameters : {
			#parameters : 10
		},
		#large_class : {
			#attributes : 15,
			#methods : 20
		},
		#unused_local_variable,
		#unused_parameter,
		#architecture : {
			#modules : {
				#ui : '.*\\.ui\\..*',
				#infra : '.*\\.infra\\..*'
			},
			#constraints : [
				'ui cannot dependOn infra'
			]
		}
	],
	#outputFormats : [
		#json,
		#html
	],
	#outputPath : '.moose-ci/report',
	#visualizations : [ ],
	#isRemote : false
}